# Copy to .env (never committed). The app loads it itself.
# Never `export` these in a shell that runs Claude Code or Switch Console.

# Models
ANTHROPIC_API_KEY=
# Pinned for every committed eval run; claude-sonnet-5-5 is the cheaper option
CK_MODEL=claude-opus-5-5
CK_REVIEWER_MODEL=claude-haiku-5-5
# Job E: reads a free-form reply to a sign-off request (only when "looks right" / "not quite" can't tell)
CK_SIGNOFF_MODEL=claude-sonnet-5-5
# Optional: job C's spoken brief
ELEVENLABS_API_KEY=

# Switch: a self-hosted 0.31.0 server (scripts/server-up.sh, Docker Compose + Gateway).
# Console 0.40.1's own local server runs natively with no Gateway UI, so it can't mint a
# registration key for a custom agent. Console connects to this
# server with "Connect to an existing server".
SWITCH_API_URL=http://127.0.0.1:18000
SWITCH_GATEWAY_URL=http://127.0.0.1:13000
# Minted by scripts/server-up.sh via POST /gateway/api-keys, or by hand on the Gateway's
# API Keys page (not the bootstrap key: agents registered with it belong to a separate account)
SWITCH_REGISTRATION_KEY=
# Setup writes SWITCH_AGENT_ID, SWITCH_AGENT_API_KEY and CK_CONNECTION_ID to .env.local

# Behaviour
CK_BURST_GAP_S=20
# off during eval replays (the harness sets it); R7 tests the caps alone
CK_CAPS=on
# 1 = kill switch: keep reading, never post
CK_PAUSE=0
# No event, ping or heartbeat from Switch for this many seconds → a fresh stream from the saved
# position; three dead restarts in a row → exit 4 for the supervisor (systemd Restart=always). 0 = off
CK_STREAM_WATCHDOG_SEC=120
# Optional parts (defaults shown), on for `npm run agent`; the eval runner sets them to 0 unless you do
# job E: idea -> "approve I<n>" -> Claude Code -> sign-off (docs/handoff-live-test.md)
# CK_JOB_E=1
# job E's work room; it's only created and posted in when its name matches CK_POST_ROOMS
# CK_BUILD_ROOM=ledgerly-build
# CK_HANDOFF_TIMEOUT_MIN=30
# backstop: no report yet → owner-desk nudge about a waiting "Allow once" card (0 = off)
# CK_HANDOFF_NUDGE_MIN=2
# job C's audio clip, and its "talk it through" link + call summary (need ELEVENLABS_API_KEY)
# CK_AUDIO_BRIEF=1
# CK_TALK_LINK=1
# The live whats_new tool behind a cloudflared quick tunnel (docs/handoff-live-test.md §3, step 0).
# Port the local tool server listens on (127.0.0.1); the tunnel URL is read from tunnel.log unless set;
# the header secret is made once in state/talk-tool-secret unless set.
# CK_TALK_TOOL_PORT=8790
# CK_TALK_TOOL_URL=
# CK_TALK_TUNNEL_LOG=tunnel.log
# CK_TALK_TOOL_SECRET=
# The tool server's public HTTPS address (same host as the tunnel). Set → the brief's talk link is
# short, <base>/talk/<random id>, redirected by the tool server for 3 hours; unset → the long
# ElevenLabs link. bare = post the short URL itself instead of a named Markdown link
# CK_PUBLIC_BASE_URL=
# CK_TALK_LINK_STYLE=named
# The public read-only status page on the same server: GET /, /status, /status.json (rooms, today's
# replies and silences, job E's ideas, recent public answers, spend vs cap; never owner-desk content,
# ids or emails). On whenever the tool server runs; 0 = off (docs/deploy-cloud.md, section 4, step 8)
# CK_STATUS_PAGE=1
CK_TRACE_FILE=state/trace.jsonl
# Public demo rooms (docs/demo-channel.md): room-name prefixes; a prefix matches the full Switch name
# or the channel part after "Guild: ". Jobs A-D only (no job E; no voice unless CK_DEMO_VOICE=1), hourly limits per person
# and per room; listened to and posted in without CK_LISTEN_ROOMS / CK_POST_ROOMS entries. Unset = none.
# CK_DEMO_ROOMS=try-context-keeper
# CK_DEMO_PER_PERSON_HOUR=6
# CK_DEMO_TRIES_PER_PERSON_HOUR=20
# CK_DEMO_PER_ROOM_HOUR=40
# never limited, besides the owner: sender ids or chat handles (your Discord handle, say)
# CK_DEMO_EXEMPT=
# voice (audio clip + talk link) in demo rooms: clips + links per UTC day across them, one voice brief per person
# CK_DEMO_VOICE=1
# CK_DEMO_VOICE_PER_DAY=15
# Estimated model spend per UTC day (state/spend.json): owner note at 80%, no model calls at 100%
# until 00:00 UTC. Unset = no cap.
# CK_DAILY_SPEND_CAP_USD=6
# Where a retraction (the owner's "wrong" under an answer) logs its miss. Unset = state/misses.jsonl;
# the eval writes testset/misses.yaml. A .jsonl name is written as JSONL, anything else as YAML.
# CK_MISSES_FILE=

# Optional: Switch Trust. wrap() fails closed, so the agent only wraps when the key is set.
SWITCH_TRUST_API_KEY=
SWITCH_TRUST_GATEWAY_URL=https://api.switchagents.ai
SWITCH_TRUST_POLICY_ID=

# Slack bot token (xoxb-) from the Switch Slack app: display names and reactions
SLACK_BOT_TOKEN=
# Optional: the Discord bot token, for the event-team room
DISCORD_BOT_TOKEN=
# Learned at setup: the owner desk room (the owner's sender id is saved in state/owner.json)
CK_OWNER_DESK_ROOM=
# 0 = stay quiet on genuinely new ideas (default: a short "recorded" reply)
CK_ANNOUNCE_NEW=1
# Where the seeded room documents' public copies live, so a source in a post links to its section
# (docs/message-style.md): <base>/demo/<room>/docs/<file>#<heading anchor>. Unset → names without links.
# CK_DOCS_BASE_URL=https://github.com/thekashifnazir/context-keeper/blob/main
